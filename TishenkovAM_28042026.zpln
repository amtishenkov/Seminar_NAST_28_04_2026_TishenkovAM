{"paragraphs":[{"text":"%spark.pyspark\r\nfrom pyspark.sql import functions as F\r\n\r\nusers = spark.createDataFrame(\r\n    [(\"u1\", \"Berlin\"), (\"u2\", \"Berlin\"), (\"u3\", \"Munich\"), (\"u4\", \"Hamburg\")],\r\n    [\"user_id\", \"city\"]\r\n)\r\norders = spark.createDataFrame(\r\n    [(\"o1\", \"u1\", \"p1\", 2, 10.0), (\"o2\", \"u1\", \"p2\", 1, 30.0), (\"o3\", \"u2\", \"p1\", 1, 10.0), \r\n     (\"o4\", \"u2\", \"p3\", 5, 7.0), (\"o5\", \"u3\", \"p2\", 3, 30.0), (\"o6\", \"u3\", \"p3\", 1, 7.0), \r\n     (\"o7\", \"u4\", \"p1\", 10, 10.0)],\r\n    [\"order_id\", \"user_id\", \"product_id\", \"qty\", \"price\"]\r\n)\r\nproducts = spark.createDataFrame(\r\n    [(\"p1\", \"Ring VOLA\"), (\"p2\", \"Ring POROG\"), (\"p3\", \"Ring TISHINA\")],\r\n    [\"product_id\", \"product_name\"]\r\n)\r\nusers.show() \r\norders.show() \r\nproducts.show()","user":"anonymous","dateUpdated":"2026-04-28T23:03:20+0000","progress":100,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+-------+-------+\n|user_id|   city|\n+-------+-------+\n|     u1| Berlin|\n|     u2| Berlin|\n|     u3| Munich|\n|     u4|Hamburg|\n+-------+-------+\n\n+--------+-------+----------+---+-----+\n|order_id|user_id|product_id|qty|price|\n+--------+-------+----------+---+-----+\n|      o1|     u1|        p1|  2| 10.0|\n|      o2|     u1|        p2|  1| 30.0|\n|      o3|     u2|        p1|  1| 10.0|\n|      o4|     u2|        p3|  5|  7.0|\n|      o5|     u3|        p2|  3| 30.0|\n|      o6|     u3|        p3|  1|  7.0|\n|      o7|     u4|        p1| 10| 10.0|\n+--------+-------+----------+---+-----+\n\n+----------+------------+\n|product_id|product_name|\n+----------+------------+\n|        p1|   Ring VOLA|\n|        p2|  Ring POROG|\n|        p3|Ring TISHINA|\n+----------+------------+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://7699e6401b66:4040/jobs/job?id=0"},{"jobUrl":"http://7699e6401b66:4040/jobs/job?id=1"},{"jobUrl":"http://7699e6401b66:4040/jobs/job?id=2"},{"jobUrl":"http://7699e6401b66:4040/jobs/job?id=3"},{"jobUrl":"http://7699e6401b66:4040/jobs/job?id=4"},{"jobUrl":"http://7699e6401b66:4040/jobs/job?id=5"},{"jobUrl":"http://7699e6401b66:4040/jobs/job?id=6"},{"jobUrl":"http://7699e6401b66:4040/jobs/job?id=7"},{"jobUrl":"http://7699e6401b66:4040/jobs/job?id=8"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1777415712225_1347177985","id":"paragraph_1777415712225_1347177985","dateCreated":"2026-04-28T22:35:12+0000","dateStarted":"2026-04-28T23:03:20+0000","dateFinished":"2026-04-28T23:03:32+0000","status":"FINISHED","focus":false},{"text":"%spark.pyspark\nfrom pyspark.sql import functions as F\n\norders_with_revenue = orders.withColumn(\"revenue\", F.col(\"qty\") * F.col(\"price\"))\norders_with_revenue.show()\n\njoined = orders_with_revenue \\\n    .join(users, \"user_id\", \"left\") \\\n    .join(products, \"product_id\", \"left\")\njoined.show()","user":"anonymous","dateUpdated":"2026-04-28T23:03:35+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+--------+-------+----------+---+-----+-------+\n|order_id|user_id|product_id|qty|price|revenue|\n+--------+-------+----------+---+-----+-------+\n|      o1|     u1|        p1|  2| 10.0|   20.0|\n|      o2|     u1|        p2|  1| 30.0|   30.0|\n|      o3|     u2|        p1|  1| 10.0|   10.0|\n|      o4|     u2|        p3|  5|  7.0|   35.0|\n|      o5|     u3|        p2|  3| 30.0|   90.0|\n|      o6|     u3|        p3|  1|  7.0|    7.0|\n|      o7|     u4|        p1| 10| 10.0|  100.0|\n+--------+-------+----------+---+-----+-------+\n\n+----------+-------+--------+---+-----+-------+-------+------------+\n|product_id|user_id|order_id|qty|price|revenue|   city|product_name|\n+----------+-------+--------+---+-----+-------+-------+------------+\n|        p3|     u2|      o4|  5|  7.0|   35.0| Berlin|Ring TISHINA|\n|        p1|     u4|      o7| 10| 10.0|  100.0|Hamburg|   Ring VOLA|\n|        p2|     u1|      o2|  1| 30.0|   30.0| Berlin|  Ring POROG|\n|        p2|     u3|      o5|  3| 30.0|   90.0| Munich|  Ring POROG|\n|        p1|     u1|      o1|  2| 10.0|   20.0| Berlin|   Ring VOLA|\n|        p1|     u2|      o3|  1| 10.0|   10.0| Berlin|   Ring VOLA|\n|        p3|     u3|      o6|  1|  7.0|    7.0| Munich|Ring TISHINA|\n+----------+-------+--------+---+-----+-------+-------+------------+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://7699e6401b66:4040/jobs/job?id=9"},{"jobUrl":"http://7699e6401b66:4040/jobs/job?id=10"},{"jobUrl":"http://7699e6401b66:4040/jobs/job?id=11"},{"jobUrl":"http://7699e6401b66:4040/jobs/job?id=12"},{"jobUrl":"http://7699e6401b66:4040/jobs/job?id=13"},{"jobUrl":"http://7699e6401b66:4040/jobs/job?id=14"},{"jobUrl":"http://7699e6401b66:4040/jobs/job?id=17"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1777415926083_283068537","id":"paragraph_1777415926083_283068537","dateCreated":"2026-04-28T22:38:46+0000","dateStarted":"2026-04-28T23:03:35+0000","dateFinished":"2026-04-28T23:03:41+0000","status":"FINISHED"},{"text":"%spark.pyspark\nfrom pyspark.sql import functions as F\nfrom pyspark.sql import Window\n\naggregated = joined.groupBy(\"city\", \"product_id\", \"product_name\").agg(\n    F.count(\"order_id\").alias(\"orders_cnt\"),\n    F.sum(\"qty\").alias(\"qty_sum\"),\n    F.sum(\"revenue\").alias(\"revenue_sum\")\n)\naggregated.show()\n\nwindow_spec = Window.partitionBy(\"city\").orderBy(F.col(\"revenue_sum\").desc())\ntop_products = aggregated.withColumn(\"rank\", F.row_number().over(window_spec)) \\\n    .filter(F.col(\"rank\") <= 2) \\\n    .drop(\"rank\") \\\n    .orderBy(\"city\", F.col(\"revenue_sum\").desc())\ntop_products.show()","user":"anonymous","dateUpdated":"2026-04-28T23:03:44+0000","progress":7,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+-------+----------+------------+----------+-------+-----------+\n|   city|product_id|product_name|orders_cnt|qty_sum|revenue_sum|\n+-------+----------+------------+----------+-------+-----------+\n| Berlin|        p1|   Ring VOLA|         2|      3|       30.0|\n|Hamburg|        p1|   Ring VOLA|         1|     10|      100.0|\n| Berlin|        p2|  Ring POROG|         1|      1|       30.0|\n| Munich|        p3|Ring TISHINA|         1|      1|        7.0|\n| Munich|        p2|  Ring POROG|         1|      3|       90.0|\n| Berlin|        p3|Ring TISHINA|         1|      5|       35.0|\n+-------+----------+------------+----------+-------+-----------+\n\n+-------+----------+------------+----------+-------+-----------+\n|   city|product_id|product_name|orders_cnt|qty_sum|revenue_sum|\n+-------+----------+------------+----------+-------+-----------+\n| Berlin|        p3|Ring TISHINA|         1|      5|       35.0|\n| Berlin|        p1|   Ring VOLA|         2|      3|       30.0|\n|Hamburg|        p1|   Ring VOLA|         1|     10|      100.0|\n| Munich|        p2|  Ring POROG|         1|      3|       90.0|\n| Munich|        p3|Ring TISHINA|         1|      1|        7.0|\n+-------+----------+------------+----------+-------+-----------+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl"